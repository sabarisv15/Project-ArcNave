# Migration-owner role (superuser created by the postgres image).
# backend/scripts/migrate.js (node-pg-migrate) connects as this role
# — never the running app.
POSTGRES_USER=arcnave_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arcnave

# Least-privilege runtime role the Express app connects as. Created
# by docker/postgres/init/01-app-role.sh at first container boot —
# subject to RLS, unlike POSTGRES_USER. See ADR-002.
ARCNAVE_APP_PASSWORD=change-me-too

# Least-privilege runtime role the Super Admin Portal API connects
# as. Created by docker/postgres/init/02-platform-role.sh — granted
# only on platform_admins/colleges/principal_invitations, nothing on
# tenant tables. See ADR-015.
ARCNAVE_PLATFORM_PASSWORD=change-me-platform

# Signs/verifies tenant access JWTs (HS256). Generate a real random
# value — e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
# — never reuse this placeholder outside local dev.
JWT_SECRET_KEY=change-me-again

# Signs/verifies platform-admin access JWTs. Deliberately a DIFFERENT
# value from JWT_SECRET_KEY — never reuse that one here, or a tenant
# and a platform token become indistinguishable by signature alone.
PLATFORM_JWT_SECRET_KEY=change-me-platform-jwt

# Optional — how long a password-reset token stays acceptable (hours).
# Leave unset to use the default (2 hours).
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

# Optional — NotificationService's real email channel (Module 8).
# Leave SMTP_HOST unset to use the log-only stub fallback (the safe
# default for local dev/test — no real mail server required).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@arcnave.local

# Optional — NotificationService's real sms/whatsapp channels
# (Twilio). Leave unset to use the log-only stub fallback (same "would
# send: {...}" treatment SMTP_HOST's own stub uses) — no real Twilio
# account required for local dev/test.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Optional — Module 9's LLM step (services/llmProvider.js), an
# NVIDIA NIM API key (https://build.nvidia.com — OpenAI-compatible
# /chat/completions). Leave unset to run with the AI tool-invoke path
# working but the "ask a question about it" path 503ing cleanly.
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct

# Optional — Module 9's RAG slice (services/documentSearchService.js),
# the embedding model behind search_documents. A different model from
# NIM_MODEL above. Leave unset to use the default (nv-embedqa-e5-v5,
# purpose-built for retrieval); if you change it, note that
# ai_document_chunks' embedding column is a fixed vector(1024) width —
# a model with a different output dimension needs a new migration too.
NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Optional — a second, optional global-default LLM provider (Google
# Gemini via Vertex AI, services/aiProviders/gemini.js). Auth is
# Application Default Credentials, NOT an API key: run
#   gcloud auth application-default login
#   gcloud config set project <your-project-id>
# for local dev (uses your GCP trial credits automatically), or rely on
# the runtime's own service account in a real GCP deployment. Leave
# GEMINI_PROJECT_ID unset to leave this provider unavailable — same
# "unset means unavailable, never a startup failure" treatment
# NIM_API_KEY above gets. To actually use Gemini instead of NIM, also
# set DEFAULT_AI_PROVIDER=gemini below.
GEMINI_PROJECT_ID=
# 'global' — Vertex AI's non-regional endpoint, not a real GCP region —
# is where gemini-3.7-flash actually serves from; a regional value like
# us-central1 404s for this model (verified live).
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash

# Optional — Gemini's embedding model (services/aiProviders/gemini.js
# embed()), a SEPARATE model from GEMINI_MODEL above (chat and
# embeddings are different model families). No default — Vertex AI has
# no first-party embedding default this app assumes; e.g.
# gemini-embedding-001.
GEMINI_EMBEDDING_MODEL=

# Optional — which global-default provider a college with no
# college_ai_config row of its own falls back to. Defaults to 'nim'.
DEFAULT_AI_PROVIDER=

# Document storage safety. Use a real random value outside local dev.
DOCUMENT_STORAGE_ROOT=/app/storage
DOCUMENT_BACKUP_ROOT=/app/storage-backups
DOCUMENT_STORAGE_ENCRYPTION_KEY=local-dev-document-key-change-me

# ADL-059 — the standalone code-execution sandbox (a separate Cloud Run
# deployment, not built by docker-compose). All three unset = the
# execute_code tool reports itself unconfigured and nothing else breaks.
SANDBOX_SERVICE_URL=
# Must equal the sandbox service's own SANDBOX_SHARED_SECRET.
SANDBOX_SERVICE_TOKEN=
# "true" only where the sandbox runs --no-allow-unauthenticated; the
# ambient Google credentials mint the Cloud Run invoker ID token.
SANDBOX_SERVICE_IAM_AUTH=false
# Host path to the sandbox-invoker service account's OWN key file
# (never the same file as GEMINI_ADC_PATH below) — mounted read-only
# into the container at /app/.gcp/sandbox-invoker.json.
SANDBOX_INVOKER_KEY_PATH=
# Must equal /app/.gcp/sandbox-invoker.json whenever SANDBOX_INVOKER_KEY_PATH
# is set — the container-side path the mount above lands at. Leave both
# blank together to fall back to GoogleAuth's own ADC search.
SANDBOX_SERVICE_CREDENTIALS_PATH=

# Review Finding #6 — kill switch for the pdfplumber PDF-table fallback
# (needs the sandbox above). "true" only after you've confirmed the
# sandbox is reachable; a reconstruction still only earns full trust when
# documentRowIntegrityService independently verifies it (Finding #3).
PDF_PLUMBER_FALLBACK_ENABLED=false

# ADL-061 — open web search and web fetch. Runs on Vertex AI using
# GEMINI_PROJECT_ID/GEMINI_LOCATION and ADC (the same credentials chat
# and embeddings use) — there is no separate key to set. Enable it
# per college via the 'web_search' configuration category.
# Optional model override; defaults to GEMINI_MODEL.
GEMINI_WEB_SEARCH_MODEL=
