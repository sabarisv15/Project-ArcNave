{
  // Type-check only — `noEmit: true` means this never produces a build
  // step or changes what Node actually runs (ADR-016 Amendment 1 /
  // ADL-072: additive tooling, not a rewrite mandate). Every existing
  // `.js` file stays exactly as-is; `allowJs` lets a `.ts` file import a
  // `.js` one (and vice versa) during the gradual migration without
  // either side needing to change first.
  //
  // New backend files may be written in `.ts` starting now. Since there
  // is still no build step in the Docker runtime (`node src/index.js`
  // unchanged), a new `.ts` file is either (a) a script run directly via
  // `npx tsx path/to/script.ts` (tsx is now a devDependency — see
  // `scripts/` for the pattern once one exists), or (b) application code
  // that the request path actually needs at runtime, which still needs
  // its own migration-path decision (a build step, or `tsx` in
  // production) before landing — not decided by this tsconfig alone.
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*"],
  "exclude": ["node_modules"]
}
